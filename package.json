{
  "name": "@alexanderjcarter/netq",
  "version": "1.1.0",
  "description": "netq：面向开发/运维/普通用户的轻量交互式网络排查 CLI（TLS / DNS 对比 / Watch / 健康分）",
  "license": "MIT",
  "author": "AlexanderJ-Carter <121274570+AlexanderJ-Carter@users.noreply.github.com>",
  "type": "commonjs",
  "types": "./src/lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderJ-Carter/netq.git"
  },
  "bugs": {
    "url": "https://github.com/AlexanderJ-Carter/netq/issues"
  },
  "homepage": "https://alexanderj-carter.github.io/netq/",
  "sideEffects": false,
  "exports": {
    ".": "./src/lib/index.js",
    "./core": "./src/lib/index.js",
    "./lib": "./src/lib/index.js"
  },
  "bin": {
    "netq": "bin/netq.js"
  },
  "engines": {
    "node": "^20.12.0 || ^21.7.0 || ^22.13.0 || >=23.5.0"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cli",
    "network",
    "diagnostics",
    "ping",
    "traceroute",
    "dns",
    "tls",
    "port",
    "devops",
    "http"
  ],
  "scripts": {
    "start": "node bin/netq.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"bin/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"bin/**/*.js\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "ora": "^9.4.0"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "js-yaml": "3.15.0",
    "brace-expansion": "5.0.8"
  }
}
